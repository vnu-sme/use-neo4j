-- Independent snapshot; load into a fresh USE state.
-- Scenario: regular. Invariant violations may be intentional.
!new Catalog('catalog_0')
!set catalog_0.name := 'Catalog 0'
!new Catalog('catalog_1')
!set catalog_1.name := 'Catalog 1'
!new Item('item_0')
!set item_0.active := false
!set item_0.name := 'Item 0'
!set item_0.price := 12.5
!insert (catalog_0, item_0) into CatalogItems
!new Item('item_1')
!set item_1.active := true
!set item_1.name := 'Item 1'
!set item_1.price := 12.5
!insert (catalog_1, item_1) into CatalogItems
!new Item('item_2')
!set item_2.active := true
!set item_2.name := 'Item 2'
!set item_2.price := 12.5
!insert (catalog_0, item_2) into CatalogItems
!new Item('item_3')
!set item_3.active := false
!set item_3.name := 'Item 3'
!set item_3.price := 12.5
!insert (catalog_1, item_3) into CatalogItems
