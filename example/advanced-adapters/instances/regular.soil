-- Independent snapshot; load into a fresh USE state.
-- Scenario: regular. Invariant violations may be intentional.
!new Library('library_0')
!new Book('book_0_0')
!insert (library_0{'A'}, book_0_0) into Catalog
!insert (library_0, book_0_0{'X'}) into Ownership
!new Loan('loan_0') between (library_0, book_0_0)
!set loan_0.note := 'Snapshot loan'
!new Book('book_0_1')
!insert (library_0{'B'}, book_0_1) into Catalog
!insert (library_0, book_0_1{'X'}) into Ownership
!new Library('library_1')
!new Book('book_1_0')
!insert (library_1{'A'}, book_1_0) into Catalog
!insert (library_1, book_1_0{'X'}) into Ownership
