!set p1.bloodType := BloodType::O_POS
!set p1.weight := 70.0
!set p1.height := 170.0
!set p1.symptoms := Sequence{'Sot cao', 'Dau dau', 'Met moi'}
!set p1.treatmentHistory := Set{Sequence{'Nhap vien'}, Sequence{'Theo doi'}}
!set p1.allergies := Set{'Penicillin'}
!set p1.attendingPhysicians := Set{dr1, dr2}
!set p1.currentMeds := Set{med1, med2}
!set p1.prescriptionHistory := Sequence{Sequence{med1}, Sequence{med2, med3}}

