-- Object reference attributes used by OCL
!set dr1.assignedNurses := Set{n1, n2}
!set dr1.patientQueue := Sequence{p1}
!set dr1.collaborationHistory := Sequence{Set{dr2}, Set{dr3}}

!set dr2.assignedNurses := Set{n3}
!set dr2.patientQueue := Sequence{p2}
!set dr2.collaborationHistory := Sequence{Set{dr1}}

!set dr3.assignedNurses := Set{n1}
!set dr3.patientQueue := Sequence{p3}
!set dr3.collaborationHistory := Sequence{Set{dr4}}

!set dr4.assignedNurses := Set{}
!set dr4.patientQueue := Sequence{}
!set dr4.collaborationHistory := Sequence{Set{dr3}}

!set h1.medicalStaff := Set{dr1, dr2, n1, n2}
!set h2.medicalStaff := Set{dr3, n3}
!set h3.medicalStaff := Set{dr4}

-- MedicalRecord: 3
!create mr1 : MedicalRecord
!create mr2 : MedicalRecord
!create mr3 : MedicalRecord

-- RecordEntry: 3
!create re1 : RecordEntry
!set re1.entryDate := '2026-05-01'
!set re1.description := 'Initial examination'

!create re2 : RecordEntry
!set re2.entryDate := '2026-05-02'
!set re2.description := 'Blood test'

!create re3 : RecordEntry
!set re3.entryDate := '2026-05-03'
!set re3.description := 'Follow up'

-- HospitalStructure: 6 links
!insert (h1, dep1) into HospitalStructure
!insert (h1, dep2) into HospitalStructure
!insert (h2, dep3) into HospitalStructure
!insert (h2, dep4) into HospitalStructure
!insert (h3, dep5) into HospitalStructure
!insert (h3, dep6) into HospitalStructure

-- PatientRecord: 3 links
!insert (p1, mr1) into PatientRecord
!insert (p2, mr2) into PatientRecord
!insert (p3, mr3) into PatientRecord

-- RecordEntries: 3 links
!insert (mr1, re1) into RecordEntries
!insert (mr2, re2) into RecordEntries
!insert (mr3, re3) into RecordEntries

-- Appointment: 1 link
!insert (dr1, p1, dep1) into Appointment

-- Consultation: 3 links
!insert (dr1, p1, dis1) into Consultation
!insert (dr2, p2, dis2) into Consultation
!insert (dr3, p3, dis3) into Consultation

-- Hospitalization: 3 association-class objects / links
!create hosp1 : Hospitalization between (p1, dep1)
!set hosp1.admissionDate := '2026-05-25'
!set hosp1.roomNumber := 302

!create hosp2 : Hospitalization between (p2, dep2)
!set hosp2.admissionDate := '2026-05-26'
!set hosp2.roomNumber := 204

!create hosp3 : Hospitalization between (p3, dep3)
!set hosp3.admissionDate := '2026-05-27'
!set hosp3.roomNumber := 105

-- Prescription: 3 association-class objects / links
!create presc1 : Prescription between (dr1, p1)
!set presc1.prescriptionID := 'RX001'
!set presc1.dosageInstructions := 'Take twice daily'

!create presc2 : Prescription between (dr2, p2)
!set presc2.prescriptionID := 'RX002'
!set presc2.dosageInstructions := 'Take once daily'

!create presc3 : Prescription between (dr3, p3)
!set presc3.prescriptionID := 'RX003'
!set presc3.dosageInstructions := 'Take after meal'

