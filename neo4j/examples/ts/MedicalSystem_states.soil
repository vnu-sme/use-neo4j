!insert (centralHospital, cardiologyDept) into HospitalStructure
!insert (centralHospital, emergencyDept) into HospitalStructure
!insert (cityHospital, neurologyDept) into HospitalStructure

!create hospitalizationAlice : Hospitalization between (patientAlice, cardiologyDept)
!set hospitalizationAlice.admissionDate := '2026-01-01'
!set hospitalizationAlice.roomNumber := 301

!create hospitalizationBob : Hospitalization between (patientBob, emergencyDept)
!set hospitalizationBob.admissionDate := '2026-02-10'
!set hospitalizationBob.roomNumber := 101

!create hospitalizationCarol : Hospitalization between (patientCarol, neurologyDept)
!set hospitalizationCarol.admissionDate := '2026-03-05'
!set hospitalizationCarol.roomNumber := 405

!create prescriptionAlice : Prescription between (doctorHouse, patientAlice)
!set prescriptionAlice.prescriptionID := 'RX-001'
!set prescriptionAlice.dosageInstructions := 'Take one tablet after breakfast'

!create prescriptionBob : Prescription between (doctorHouse, patientBob)
!set prescriptionBob.prescriptionID := 'RX-002'
