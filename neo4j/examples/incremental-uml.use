model Incremental

class Kien
attributes
    name : String
    age : String
    male: String
end

class Linh
attributes
    namei : String
    age : String
    female: String
end

class Meokk
attributes
    namei : String
    age : String
    female: String
end

class Meme
attributes
    namei : String
    age : String
    female: String
end

composition Family between
    Kien[1] role husband
    Linh[1] role wife
end

association Ny between
    Kien[1] role boyfriend
    Linh[1] role girlfriend
end

aggregation Lover between
    Linh[1] role female
    Kien[1] role male

end


