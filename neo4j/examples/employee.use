model Employee


enum Gender { Male, Female, Other }
enum ContractType { FullTime, PartTime, Intern, Consultant }

class Person
attributes
    name : String
    age : Integer
    salary : Real
    sex : Gender
    uni: University
end

class University
attributes
    name : String
    location : String
operations
    fires(p:Person)
    pre firePre: self.employee->includes(p)
    post firePost: self.employee->excludes(p)
end

class Student < Person
end

class Professor < Person
end

-- association

composition WorksFor between
    Person[*] role employee
    University[0..1] role employer
end

associationclass Employment
  between
    Person[*] role source
    University[0..1] role target
attributes
    startDate : String
    position : String
    contractType : ContractType

end


constraints

context Professor
inv HigherSalaryThanStudent:
Student.allInstances()->forAll(s:Student|s.salary < self.salary)
