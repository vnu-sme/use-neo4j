!create MIT : University
!create Stanford : University

!create ProfSmith : Professor
!create ProfJones : Professor

!create Alice : Student
!create Bob : Student
!create Charlie : Student

!create A1 : C1Assoc
!create A2 : C1Assoc
!create G1 : C2Aggreg

!set MIT.name := 'Massachusetts Institute of Technology'
!set MIT.location := 'Cambridge'
!set Stanford.name := 'Stanford University'
!set Stanford.location := 'California'

!set ProfSmith.name := 'John Smith'
!set ProfSmith.age := 50
!set ProfSmith.salary := 8000.0
!set ProfSmith.sex := Gender::Male

!set Alice.name := 'Alice Wonderland'
!set Alice.age := 20
!set Alice.salary := 0.0
!set Alice.sex := Gender::Female

!set Bob.name := 'Bob Builder'
!set Bob.age := 24
!set Bob.salary := 1500.0
!set Bob.sex := Gender::Male

!set ProfSmith.codes := Set{'CS101', 'SE202', 'AI303'}

!set ProfSmith.codesBag := Bag{'Login', 'Login', 'Logout'}

!set ProfSmith.nested := Set{Set{'High', 'Medium'}, Set{'Low'}}

!set Alice.nestedDiff := Set{Bag{'A', 'A', 'B'}, Bag{'C'}}

!insert (ProfSmith, MIT) into WorksFor
!insert (ProfJones, Stanford) into WorksFor
!insert (Alice, MIT) into WorksFor -- Alice làm thêm tại trường

!create contract1 : Employment between (ProfSmith, MIT)
!set contract1.startDate := '2020-01-01'
!set contract1.position := 'Head of Dept'
!set contract1.contractType := ContractType::FullTime

!create contract2 : Employment between (Alice, MIT)
!set contract2.startDate := '2023-09-01'
!set contract2.position := 'Research Assistant'
!set contract2.contractType := ContractType::PartTime

-- (Person=ProfSmith, University=MIT, Student=Alice)
!insert (ProfSmith, MIT, Alice) into Ternari

!insert (A1, MIT) into DemoAssociation
!insert (A2, MIT) into DemoAssociation
!insert (G1, Stanford) into DemoAggregation







-- 8. MÔ PHỎNG GỌI HÀM VÀ KIỂM TRA RÀNG BUỘC (OPERATION SIMULATION)
-- Case 1: Kiểm tra hàm isEligibleForPromotion()
-- ProfSmith (Age 50, Salary 8000) -> Salary > 5000 nên kết quả sẽ là false
? ProfSmith.isEligibleForPromotion()

-- Bob (Age 24, Salary 1500) -> Age < 25 nên kết quả sẽ là false
? Bob.isEligibleForPromotion()

-- Case 2: Mô phỏng hàm fires(p: Person) của University
-- Pre-condition: Person phải đang làm việc cho University (có trong WorksFor)
-- Post-condition: Person bị xóa khỏi WorksFor

-- Bước 1: Vào hàm
!openter MIT fires(Alice)

-- Bước 2: Thực hiện logic của hàm (Xóa liên kết thủ công)
!delete (Alice, MIT) from WorksFor

-- Bước 3: Thoát hàm và kiểm tra Post-condition
!opexit